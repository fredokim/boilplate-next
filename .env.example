# The shared backend (fredokim/boilplate-server). Leave unset to run on dummy
# data — the route handlers under src/app/api answer from it.
#
# No NEXT_PUBLIC_ prefix, deliberately. The browser must not call the backend
# directly: the refresh cookie is sameSite=lax and would not travel. The route
# handlers forward instead, so the browser stays on this app's origin.
# BACKEND_URL=http://127.0.0.1:3001

# Whether the browser builds real transports or mock ones. It must agree with
# BACKEND_URL: `assertDataModeMatches` in the root layout refuses a build where
# one is set and the other is not, because half-connected — realtime on mocks
# while HTTP is live — looks like working software from the UI.
#
# Two variables rather than one because neither can be derived from the other:
# the address has to stay off the client, and what the browser needs to know is
# only which transport to construct.
# NEXT_PUBLIC_DATA_MODE=server
