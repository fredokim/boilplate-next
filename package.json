{
  "name": "next-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:feature": "tsx scripts/generate-feature.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:contract": "vitest run src/test/contract",
    "contract:sync": "tsx scripts/sync-contract.ts",
    "storybook": "storybook dev -p 6008 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "e2e": "playwright test",
    "generate": "tsx scripts/generate.ts",
    "generate:contract": "tsx scripts/generate-contract.ts",
    "generate:form": "tsx scripts/generate-form.ts",
    "generate:layout": "tsx scripts/generate-layout.ts",
    "generate:page": "tsx scripts/generate-page.ts",
    "check:automation": "tsx scripts/check-automation.ts",
    "check:generators": "tsx scripts/check-generators.ts",
    "check:bundle": "tsx scripts/check-bundle-budget.ts",
    "check:deps": "tsx scripts/check-dependency-size.ts",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:ci": "npm run check:tokens && npm run check:docs && npm run check:env && npm run lint && npm run typecheck && npm run test && npm run check:contract && npm run check:automation && npm run check:generators && npm run check:deps && npm run build && npm run check:bundle && npm run build-storybook",
    "preperf:lighthouse": "npm run build",
    "perf:lighthouse": "npx -y @lhci/cli@0.15.1 autorun --config=./lighthouserc.cjs",
    "check:env": "tsx scripts/check-env-example.ts",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.14.10",
    "@visx/xychart": "^4.0.0",
    "@xyflow/react": "^12.11.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "hls.js": "^1.7.1",
    "next": "^16.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grid-layout": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/nextjs-vite": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "axe-core": "^4.11.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "sass": "^1.100.0",
    "storybook": "^10.4.1",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
